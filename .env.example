# Copy this file to .env and fill in real values for local dev.
# Production reads ANTHROPIC_API_KEY from AWS SSM SecureString
# (see scripts/set-secrets.sh). .env is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — override defaults from api/limits.py
# DAILY_BUDGET_USD=0.50
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECS=3600
